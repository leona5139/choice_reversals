# Makefile for fairness paper

# usage:
# - run `make all` (or just `make`) if you want to create from the CSV files 
# that have had columns with identifying information stripped
# - run `make from-raw` if you want to create from the untouched CSV files
# - run `make clean-all` to remove all but the source files and raw data

##### OPTIONS #####

## directory setup

### main directory to run everything from
DIR = .

### where the data lives
DATA-DIR         = $(DIR)/data
RAW-DATA-DIR     = $(DATA-DIR)/raw
DEID-DATA-DIR    = $(DATA-DIR)/de-identified
CLEAN-DATA-DIR   = $(DATA-DIR)/clean
RAW-DATA-FILES   = $(wildcard $(RAW-DATA-DIR)/*.csv)
CLEAN-DATA-FILES = $(CLEAN-DATA-DIR)/clean-data.rda $(CLEAN-DATA-DIR)/allocations.dta

### where all the analysis code lives (does not include source for tex files)
SRC-DIR = $(DIR)/code

### where the output generated by the analysis code goes (does not include latex output)
OUTPUT-DIR = $(DIR)/output
MODELS-DIR = $(OUTPUT-DIR)/models
TABLES-DIR = $(OUTPUT-DIR)/tables
LOGS-DIR   = $(OUTPUT-DIR)/logs

### where the paper (tex source and compiled PDF) lives
PAPER-DIR  = $(DIR)/paper
PAPER-NAME = fairness
PAPER      = $(PAPER-DIR)/$(PAPER-NAME)
PLOTS-DIR  = $(OUTPUT-DIR)/plots


##### SCRIPT #####

# primary make commands
all:                data regressions plots
from-raw: data-deid data regressions plots

# shortcuts for the below steps
data-deid: 	 $(LOGS-DIR)/data-deidentification.Rout
data:        $(LOGS-DIR)/data-cleaning.Rout
tests:       $(LOGS-DIR)/tests.Rout
regressions: $(LOGS-DIR)/regressions.log
plots:       $(LOGS-DIR)/plots.Rout
paper:       $(PAPER).pdf

# de-indentify raw data by stripping out certain columns
$(LOGS-DIR)/data-deidentification.Rout: $(SRC-DIR)/data-deidentification.R
	R CMD BATCH --no-save $<
	mv data-deidentification.Rout $(LOGS-DIR)/

# from de-identified data, make cleaned data in R and Stata formats
$(LOGS-DIR)/data-cleaning.Rout: $(SRC-DIR)/data-cleaning.R
	R CMD BATCH --no-save $<
	mv data-cleaning.Rout $(LOGS-DIR)/

# test cleaned data
$(LOGS-DIR)/tests.Rout: $(SRC-DIR)/tests.R
	R CMD BATCH --no-save $<
	mv tests.Rout $(LOGS-DIR)/

# using cleaned data, run regressions and tests in Stata
$(LOGS-DIR)/regressions.log: $(SRC-DIR)/regressions.do data
	stata-se -b $<
	mv $(notdir $(basename $<)).log $(LOGS-DIR)/
	rm -f responses-temp.dta
	rm -f allocations-temp.dta
	rm -f participants-temp.dta

# using cleaned data, make plots in R
$(LOGS-DIR)/plots.Rout: $(SRC-DIR)/plots.R data
	R CMD BATCH $(SRC-DIR)/plots.R
	mv plots.Rout $(LOGS-DIR)/
	rm -rf Rplots.pdf

# using plots, make paper document
$(PAPER).pdf: $(PAPER).tex plots regressions
	cd $(PAPER-DIR); latexmk -pdf $(PAPER-NAME).tex

# clean up all output 
clean:
	rm -drf $(CLEAN-DATA-DIR)/*
	rm -drf $(PLOTS-DIR)/*.pdf
	rm -drf $(MODELS-DIR)/*
	rm -drf $(LOGS-DIR)/*
	rm -drf $(TABLES-DIR)/*
	latexmk -C -outdir=$(PAPER-DIR) $(PAPER)
	rm -drf $(PAPER-DIR)/*.eps
	rm -drf $(PAPER-DIR)/*.bbl
	rm -drf $(PAPER-DIR)/*.ttt
	rm -drf $(PAPER-DIR)/*.fff
	rm -f .RData
	rm -f .Rhistory

# clean up just latex auxillary files
clean-tex:
	latexmk -c -outdir=$(PAPER-DIR) $(PAPER)
	rm -drf $(PAPER-DIR)/*.bbl

clean-all: clean
	rm -rf $(DEID-DATA-DIR)/*

# references
	# https://github.com/mapping-elections/data-cleaning/blob/master/Makefile
	# http://zmjones.com/make/
	# http://kbroman.org/minimal_make/
