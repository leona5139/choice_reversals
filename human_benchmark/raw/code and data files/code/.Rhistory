histogram_opts <- list(
geom_bar(stat="identity"),
geom_errorbar(aes(ymin=Mean-2*SE, ymax=Mean+2*SE, width=.2),
stat = "identity", position = position_dodge(.9)),
annotate("text",x=2, y=.9, label="Offset", size=4),
annotate("text",x=4.5, y=.9, label="No Offset", size=4),
geom_vline(xintercept=3.5, linetype="longdash", color="grey"),
scale_fill_manual(values=c("#b30000", "#e34a33", "#fc8d59", "#2b8cbe", "#045a8d")),
theme_bw(),
theme(axis.text.x = element_blank()),
xlab("Choice category"),
ylab("Frequency")
)
responses %>%
filter(Round <= 4 & treatment %in% "EA_EASR") %>%
group_by(category) %>%
summarize(Mean = n(), SE = NA) %>%
ggplot(aes(x=category, y=Mean, fill=category)) +
histogram_opts
responses %>%
filter(Round <= 4 & treatment %in% c("EP_EASR", "EA_EASR") & !is.na(response)) %>%
group_by(category, treatment) %>%
summarize(count = n(), SE = NA) %>%
group_by(treatment) %>%
mutate(Mean = count/sum(count)) %>%
ggplot(aes(x=category, y=Mean, fill=category)) +
facet_wrap(~treatment) +
histogram_opts
