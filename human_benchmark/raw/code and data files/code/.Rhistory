{
read_csv(file.path(x)) %>%
select(`ResponseID`, starts_with("choice")) %>%
melt(id.vars="ResponseID", value.name = "response")
}
#### Constants ####
offsetting_amounts <-
data.frame(
Round = 1:8,
`Offsetting Amount` = c(7,2,10,1,8,3,9,0)
)
#### SCRIPT #####
responses <-
data.frame(file = list.files("../data/de-identified", full.names = T, pattern = "v33"), stringsAsFactors = F) %>%
mutate(
responses = map(file, ~read_responses(.))
) %>%
unnest() %>%
mutate(
treatment = factor(str_extract(file, "(EA_EASR)|(EP_EASR)|(EAEP_EASR)|(EPEA_EASR)|(EASR_EACAR)")),
Round = case_when(
str_detect(.$variable, "D1") ~ 1,
str_detect(.$variable, "D2") ~ 2,
str_detect(.$variable, "D3") ~ 3,
str_detect(.$variable, "D4") ~ 4,
str_detect(.$variable, "choice1") ~ 5,
str_detect(.$variable, "choice2") ~ 6,
str_detect(.$variable, "choice3") ~ 7,
str_detect(.$variable, "choice4") ~ 8
),
revision = str_detect(variable, ".*r"),
round_treatment = case_when(
.$treatment == "EP_EASR" & .$Round %in% c(1:4) ~ "EP",
.$treatment == "EPEA_EASR" & .$Round %in% c(1,2) ~ "EP",
.$treatment == "EAEP_EASR" & .$Round %in% c(3,4) ~ "EP",
.$treatment == "EASR_EACAR" & .$Round %in% c(5:8) ~ "EACAR",
TRUE ~ "EA"
)
) %>%
merge(offsetting_amounts) %>%
mutate(
alpha = (response-5)/(Offsetting.Amount-5),
category = case_when(
alpha < 0 ~ "Reinforcing",
alpha == 0 ~ "No offsetting",
0 < alpha & alpha < 1 ~ "Partial offsetting",
alpha == 1 ~ "Full offsetting",
alpha > 1 ~ "Excessive offsetting"
),
category = factor(category, levels = c("Excessive offsetting", "Full offsetting", "Partial offsetting", "No offsetting", "Reinforcing"))
)
read_responses <- function(x){
read_csv(file.path(x)) %>%
select(`ResponseID`, starts_with("choice")) %>%
melt(id.vars="ResponseID", value.name = "response")
}
#### Constants ####
offsetting_amounts <-
data.frame(
Round = 1:8,
`Offsetting Amount` = c(7,2,10,1,8,3,9,0)
)
responses <-
data.frame(file = list.files("../data/de-identified", full.names = T, pattern = "v33"), stringsAsFactors = F) %>%
mutate(
responses = map(file, ~read_responses(.))
) %>%
unnest() %>%
mutate(
treatment = factor(str_extract(file, "(EA_EASR)|(EP_EASR)|(EAEP_EASR)|(EPEA_EASR)|(EASR_EACAR)")),
Round = case_when(
str_detect(.$variable, "D1") ~ 1,
str_detect(.$variable, "D2") ~ 2,
str_detect(.$variable, "D3") ~ 3,
str_detect(.$variable, "D4") ~ 4,
str_detect(.$variable, "choice1") ~ 5,
str_detect(.$variable, "choice2") ~ 6,
str_detect(.$variable, "choice3") ~ 7,
str_detect(.$variable, "choice4") ~ 8
),
revision = str_detect(variable, ".*r"),
round_treatment = case_when(
.$treatment == "EP_EASR" & .$Round %in% c(1:4) ~ "EP",
.$treatment == "EPEA_EASR" & .$Round %in% c(1,2) ~ "EP",
.$treatment == "EAEP_EASR" & .$Round %in% c(3,4) ~ "EP",
.$treatment == "EASR_EACAR" & .$Round %in% c(5:8) ~ "EACAR",
TRUE ~ "EA"
)
) %>%
merge(offsetting_amounts) %>%
mutate(
alpha = (response-5)/(Offsetting.Amount-5),
category = case_when(
alpha < 0 ~ "Reinforcing",
alpha == 0 ~ "No offsetting",
0 < alpha & alpha < 1 ~ "Partial offsetting",
alpha == 1 ~ "Full offsetting",
alpha > 1 ~ "Excessive offsetting"
),
category = factor(category, levels = c("Excessive offsetting", "Full offsetting", "Partial offsetting", "No offsetting", "Reinforcing"))
)
